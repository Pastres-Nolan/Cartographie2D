from spherov2 import scanner
from spherov2.sphero_edu import SpheroEduAPI
from threading import Thread
from math import sqrt
import time

toy = scanner.find_toy()

with SpheroEduAPI(toy) as bot:
        
    def rouler():
        bot.set_speed(60)
        bot.set_heading(0)
        bot.roll(0, 60, 5)
        
    thread1 = Thread(target = rouler).start()
    start_time = time.time()
    
    def revenir():
        bot.set_speed(60)
        bot.set_heading(180)
        bot.roll(0, 60, 5)
        
        bot.set_heading(0)
        bot.spin(90, 2)
        bot.roll(0, 60, 2)
        
        bot.set_heading(0)
        bot.spin(90, 2)
        bot.roll(0, 60, 2)
        
    
    try:
        while True:
            velocity = bot.get_velocity
            
            if velocity != None:
                vitesse = sqrt(velocity['x']**2 + velocity['y']**2)
                collisions = []
                if vitesse <= 0.4:
                    collisions.append(bot.get_location)
                    bot.stop()
                    #thread1.stop()
                    revenir()
                    
                    
    except KeyboardInterrupt:
        print("Program stopped.")
        bot.stop()
