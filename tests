from spherov2 import scanner
from spherov2.commands.sphero import sphero
import time

toy = scanner.find_toy(toy_name="SB-DB73")

sphero.set_motion_timeout(toy, 2000)
sphero.roll(toy, speed=60, heading=0)

end_time = time.time() + 2.1
while time.time() < end_time:
    pass

sphero.roll(toy, speed=60, heading=180)
