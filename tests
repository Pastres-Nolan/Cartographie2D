from spherov2 import scanner
from spherov2.sphero_edu import SpheroEduAPI
from spherov2.types import Color
from threading import Thread
import random as rd
import time

BOT_SPEED = 30
COLLISION_TIME = 5
SAMPLING_RATE = 0.3


pos_collisions = []
pos_all = [(0, 0)]
toy = scanner.find_toy(toy_name="SB-DB73")

def policia(bot):
    bot.set_front_led(Color(255, 0, 0))
    bot.set_back_led(Color(0, 0, 255))
    
    bot.set_front_led(Color(0, 0, 255))
    bot.set_back_led(Color(255, 0, 0))


def random_collision_SLAM(bot):
    bot.set_speed(BOT_SPEED)
    bot.set_heading(0)
    bot.set_stabilize(True)
    
    policia(bot)
    
    while True:
        heading = int(180 + rd.random() * 50 * rd.choice([-1, 1])) 
        bot.roll(bot.get_heading() + heading, BOT_SPEED, 5)
        coll_position = bot.get_location()
        coll_position = (coll_position['x'],  coll_position['y'])
        pos_collisions.append(coll_position)
        time.sleep(1)


def position_tracking(bot, stop_event, pos_all):
    dt = SAMPLING_RATE
    while True:
        velocite = bot.get_velocity()
        
        if velocite:
            vx, vy = velocite['x'], velocite['y']
            x_initial, y_initial = pos_all[-1]
            x = x_initial + vx * dt
            y = y_initial + vy * dt
            pos_all.append((x, y))

        time.sleep(SAMPLING_RATE)
    
    
    
with SpheroEduAPI(toy) as bot:
    Thread(target = random_collision_SLAM, args = (bot)).start()
    

    try:
        random_collision_SLAM(bot)    
            
    except KeyboardInterrupt:
        print("Programme interrompu.")
        bot.stop_roll()
