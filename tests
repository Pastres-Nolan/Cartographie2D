from spherov2 import scanner
from spherov2.sphero_edu import SpheroEduAPI
from threading import Thread, Event
from math import sqrt
import random as rd
import time

BOT_SPEED = 50
COLLISION_SPEED = 0.3
EPOCH = time.time()

pos_collisions = []
pos_all = []

toy = scanner.find_toy(toy_name="SB-DB73")
collision = Event()
movement_thread = None

def random_collision_SLAM(bot, collision):
    random_heading =  140 + int(rd.random() * 80)
    bot.set_speed(BOT_SPEED)
    bot.set_heading(bot.get_heading() + random_heading)
    bot.set_stabilization(True)
    
    while not collision.is_set():
        curr_position = bot.get_location()
        pos_all.append((curr_position['x'],  curr_position['y']))
        bot.roll(bot.get_heading(), BOT_SPEED, 0.8)
        time.sleep(0.3)
    

def appel_random_collision(bot, collision):
    global movement_thread
    
    if movement_thread and movement_thread.is_alive():
        movement_thread.join()

    collision.clear()
    movement_thread = Thread(target=random_collision_SLAM, args=(bot, collision))
    movement_thread.start()


with SpheroEduAPI(toy) as bot:
    
    movement_thread = Thread(target = random_collision_SLAM, args = (bot, collision))
    movement_thread.start()
    
    try:
        while True:
            velocity = bot.get_velocity()
            if velocity is not None:
                vitesse = sqrt(velocity['x']**2 + velocity['y']**2)
                
                if vitesse <= COLLISION_SPEED and time.time() - EPOCH > 1:
                    bot.stop_roll()
                    collision_pos = bot.get_location()
                    pos_collisions.append((collision_pos['x'],  collision_pos['y']))
                    
                    EPOCH = time.time()
                    collision.set()
                    time.sleep(0.3)
                    appel_random_collision(bot, collision)
                    
                    print("Collision Detectee")
                    
                    
    except KeyboardInterrupt:
        print("Programme interrompu.")
        bot.stop_roll()
